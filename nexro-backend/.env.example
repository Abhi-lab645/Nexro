# Nexro Central Backend Gateway Environment Configuration
# Copy this file to .env and configure with your local values.
# DO NOT commit .env to version control.

# Server Configuration
PORT=5001
NODE_ENV=development

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=nexro_db
PGUSER=postgres
PGPASSWORD=postgres

# Microservice Integrations
AI_SERVICE_URL=http://localhost:8000

# Authentication & Security
JWT_SECRET=nexro_development_jwt_secret_statutory_ledger_key

# Firebase Cloud Messaging / Admin SDK (Optional: falls back to simulation mode if absent)
FIREBASE_KEY_PATH=./serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
